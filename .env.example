# Copie para .env.local (`cp .env.example .env.local`) e preencha.
# Este arquivo NÃO tem segredos: os valores abaixo são de desenvolvimento local.
# O mesmo .env.local alimenta o Next (`npm run dev`) e o compose
# (`docker compose -p quiz-oab --env-file .env.local up -d --build`), para o
# segredo do serviço de PDF e as portas ficarem iguais dos dois lados.

# ---- Supabase (Next, só servidor) ----
# O supabase/config.toml deste repo desloca as portas do Supabase local para a
# faixa 643xx (API 64321, banco 64322, Studio 64323) em vez do padrão 543xx do
# CLI — assim ele convive com outros projetos Supabase locais na mesma máquina.
SUPABASE_URL=http://127.0.0.1:64321
SUPABASE_SERVICE_ROLE_KEY=            # `npx supabase status` → "Secret key" / service_role

# ---- Admin (/admin) ----
ADMIN_PASSWORD=troque-isto
# Gere com: openssl rand -base64 48   — trocar invalida TODAS as sessões do admin.
ADMIN_SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# ---- Serviço de PDF (services/diagnostico-pdf) ----
DIAGNOSTICO_SERVICE_URL=http://localhost:8000   # porta = DIAGNOSTICO_PDF_PORT abaixo
DIAGNOSTICO_SERVICE_SECRET=segredo-local        # o MESMO no Next e no serviço Python

# ---- S3 (Next: só para ASSINAR a URL entregue ao navegador) ----
BUCKET_NAME=diagnosticos-oab
REGION=us-east-1
# Na AWS: NÃO definir ACCESS_KEY/SECRET_KEY (o SDK usa a IAM role). Só local/MinIO:
ACCESS_KEY=minioadmin
SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000          # MinIO local; vazio na AWS
S3_PUBLIC_ENDPOINT=http://localhost:9000   # o que o NAVEGADOR enxerga; vazio na AWS (no compose o Python usa http://minio:9000)

# ---- E-mail (SMTP). SMTP_HOST vazio = não envia e registra email_erro ----
SMTP_HOST=localhost       # Mailpit local (UI em http://localhost:8025)
SMTP_PORT=1025            # = MAILPIT_SMTP_PORT abaixo
SMTP_SECURE=0             # 1 = TLS direto (porta 465)
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Método VDE <nao-responda@localhost>"

# ---- App ----
APP_URL=http://localhost:3000    # base do link do diagnóstico no e-mail (a porta do `next dev`)
# Libera ?hoje=AAAA-MM-DD para simular a data.
# Defina 1 SÓ localmente/e2e (no seu .env.local); NUNCA em produção.
ALLOW_HOJE_OVERRIDE=

# ---- Públicas (embutidas no bundle no BUILD: no Docker, passar como --build-arg) ----
NEXT_PUBLIC_WHATSAPP=5500000000000   # número do WhatsApp do VDE (DDI+DDD+número, só dígitos)
NEXT_PUBLIC_PRIVACIDADE_URL=         # link da política de privacidade (vazio = sem link)
NEXT_PUBLIC_VIDEO_PARTE2=            # URL do vídeo da parte 2 (vazio = sem vídeo)

# ---- Portas do host do docker-compose (só local; mude se colidirem) ----
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
DIAGNOSTICO_PDF_PORT=8000

# ---- E2E (Playwright) ----
E2E_PORT=3100                        # porta do `next dev` que o e2e sobe/reutiliza
